{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PoEmotes",
  "version": "1.0.0",
  "identifier": "com.zombodotcom.poemotes",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PoEmotes",
        "width": 520,
        "height": 380,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src https: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "zombodotcom",
    "shortDescription": "Twitch/BTTV/FFZ/7TV emotes in Path of Exile chat"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENEQTAwMDU3Mzc5RUYxNTUKUldSVjhaNDNWd0NnelExWHFJcUgxMWRCSG1EWk9CRE1WdHZTRVJKcDlMMFlDTFRIUnhFVW4zaUkK",
      "endpoints": [
        "https://github.com/zombodotcom/PoEmotes/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
